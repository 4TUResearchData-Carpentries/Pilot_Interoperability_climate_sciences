  "@type": "Course",
  "name": "Interoperability in Climate and Atmospheric Sciences: FAIR NetCDF Data workshop",
  "description": "A hands-on pilot workshop on creating interoperable, FAIR climate and atmospheric science datasets using NetCDF, metadata standards, persistent identifiers, and practical data access patterns.",
  "url": "https://4turesearchdata-carpentries.github.io/interoperability-climate-sciences/",
  "courseCode": "INTEROP-CLIMATE-FAIR",
