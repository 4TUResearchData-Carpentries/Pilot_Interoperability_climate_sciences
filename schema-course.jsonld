    "sameAs": "https://www.4tu.nl/"
  },
  "educationalLevel": "Intermediate",
  "audience": [
    "Researchers",
    "Data stewards",
    "Data engineers",
    "Research software engineers"
  ],
  "timeRequired": "PT7H",
  "coursePrerequisites": [
    {
      "@type": "CreativeWork",
      "name": "Basic Python experience (write and run short scripts)"
    },
    {
      "@type": "CreativeWork",
      "name": "Awareness of the NetCDF format"
    },
    {
      "@type": "CreativeWork",
      "name": "Access to a Unix-like terminal (Git Bash, WSL, Mac/Linux terminal)"
    }
  ],
  "teaches": [
    "FAIR principles for climate and atmospheric science data",
    "Structural interoperability for NetCDF datasets",
    "Semantic interoperability and metadata conventions",
    "Technical interoperability through data access protocols and APIs",
    "Cloud-native layouts for scientific workflows",
    "Interoperable infrastructure in the AI era",
    "Hands-on creation and publication of interoperable research outputs"
  ],
  "hasPart": [
    {
      "@type": "CourseSection",
      "position": 1,
      "name": "Introduction to interoperability",
      "description": "Overview of FAIR and interoperable research outputs for climate data"
    },
    {
      "@type": "CourseSection",
      "position": 2,
      "name": "Structural interoperability",
      "description": "Standards, data structures, and dataset design for interoperability"
    },
    {
      "@type": "CourseSection",
      "position": 3,
      "name": "Semantic interoperability",
      "description": "Metadata, vocabularies, and meaningful data descriptions"
    },
    {
      "@type": "CourseSection",
      "position": 4,
      "name": "Technical interoperability",
      "description": "Data access protocols and API-based interoperability"
    },
    {
      "@type": "CourseSection",
      "position": 5,
      "name": "Cloud-native layouts and AI-ready infrastructure",
      "description": "Modern infrastructure patterns for reusable and scalable scientific data workflows"
    }
  ],
